<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ swarm_app_name }} · {{ env_name | upper }}</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; display: grid; place-items: center; min-height: 100vh;
           background: {{ {'dev': '#e8f5e9', 'uat': '#fff8e1', 'prod': '#e3f2fd'}[env_name] | default('#f5f5f5') }}; color: #222; }
    main { text-align: center; padding: 2rem; }
    h1 { margin: 0 0 .5rem; font-size: 2.5rem; }
    code { background: #0001; padding: .15rem .4rem; border-radius: 4px; }
  </style>
</head>
<body>
  <main>
    <h1>{{ swarm_app_name }} — {{ env_name | upper }}</h1>
    {# No replica count here: it would change the config on every scale and force a needless rolling restart. #}
    <p>Image <code>{{ swarm_app.image }}:{{ swarm_app.version }}</code></p>
    <p>Deployed by Ansible to Docker Swarm. Per-replica details: <a href="/info">/info</a></p>
  </main>
</body>
</html>
